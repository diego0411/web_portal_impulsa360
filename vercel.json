{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js?__api_path=$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(?!api(?:/|$))(?!.*\\.[^/]+$)(.*)",
      "dest": "/index.html"
    }
  ]
}
